# =============================================================================
# TunnelGate environment file
#
#   sudo install -m 0600 /dev/null /etc/tunnelgate.env
#   sudo editor /etc/tunnelgate.env
#
# Read by systemd (EnvironmentFile=) and by docker compose (env_file:). Every key
# is TUNNELGATE_-prefixed because app/config.py uses that env_prefix. Full
# reference: docs/INSTALL_SERVER.md section 5.
#
# Generate the secrets, do not invent them:
#   openssl rand -base64 48   -> TUNNELGATE_SECRET_KEY
#   openssl rand -base64 24   -> TUNNELGATE_ADMIN_PASSWORD
# Losing TUNNELGATE_SECRET_KEY invalidates every stored console key.
# =============================================================================

TUNNELGATE_ENV=production
# critical | error | warning | info | debug. Applies to the panel's own "tunnelgate" logger tree
# (proxy rendering, monitor state changes, console lifecycle, auth events). The default, info,
# is what journalctl -u tunnelgate is worth reading at; debug logs one line per proxy decision
# and is for short-lived troubleshooting only, not a steady state.
TUNNELGATE_LOG_LEVEL=info

# --- panel ---------------------------------------------------------------
# PANEL_URL is what the panel's OWN reverse proxy forwards to. Point it at loopback
# (http://127.0.0.1:8080) when a TLS terminator sits in front; pointing it at the public
# name makes nginx dial itself back through the edge. See docs/INSTALL_SERVER.md §7.
TUNNELGATE_PANEL_URL=https://panel.example.com
TUNNELGATE_PANEL_HOST=panel.example.com
# The origin a BROWSER sees, used by every redirect the panel writes: the login bounce
# from a router vhost and the router launch hand-off. Unset, it is derived from
# PANEL_URL's scheme plus PANEL_HOST - correct on a flat install. SET IT whenever
# PANEL_URL is loopback, otherwise a router visitor is redirected to http://127.0.0.1.
TUNNELGATE_PUBLIC_URL=https://panel.example.com
# --- how routers are published ------------------------------------------
# Two modes, chosen with ROUTE_MODE.
#
# subdomain (the default): every router gets its own host, <slug>.<SUBDOMAIN_SUFFIX>,
# and the console is console.<suffix>. This needs a WILDCARD certificate
# (*.<suffix>) and a wildcard DNS record, because <slug> is only known after the
# router is registered. DNS-01 is the only ACME challenge that can issue a wildcard.
TUNNELGATE_ROUTE_MODE=subdomain
TUNNELGATE_SUBDOMAIN_SUFFIX=panel.example.com
#
# path: every router is published on ONE host at /<slug>/, for example
# https://gate.example.com/lab-router/. Use this when you do NOT have a wildcard
# certificate - a free dynamic-DNS name such as gate.example.duckdns.org works,
# since only that single name needs a certificate - or when the deployment has no
# DNS control at all. Requirements, all enforced by "app.cli doctor":
#   * TUNNELGATE_GATEWAY_HOST names that one host; it must be a real DNS name, not
#     an IP address (a CA cannot issue for an IP), and empty or dotless names are
#     rejected too. Every router is served on it;
#   * TUNNELGATE_PROXY_DRIVER=nginx - the path driver rewrites LuCI's absolute
#     links and scopes each router's cookie to /<slug>/, which caddy cannot do here;
#   * that nginx needs --with-http_sub_module (the distro nginx package has it).
#     Doctor reports it as "sub_filter module"; without it LuCI pages load with
#     unprefixed CSS and dead links.
#
# Path mode has TWO LAYOUTS, picked by comparing GATEWAY_HOST with PANEL_HOST. There
# is no flag for it, and the nginx include moves with the choice:
#
#   separate (recommended) - GATEWAY_HOST != PANEL_HOST, e.g. gate.example.com while
#     the panel stays panel.example.com. routes.conf holds one complete server{}
#     block for the gateway plus the map $http_upgrade $tg_connection_upgrade, and is
#     included in the nginx HTTP context, exactly as before. Router pages are a
#     different ORIGIN from the panel, so a compromised router cannot act inside it.
#
#   merged - GATEWAY_HOST == PANEL_HOST, e.g. both gate.example.com. Use it only
#     when one public name is all you have (a free dynamic-DNS name with no
#     wildcard, a single certificate, a panel on a bare IP). routes.conf then holds
#     ONLY locations - /__tg/auth (internal), @tg_login, /<slug>/__tg/enter,
#     /<slug>/ and "= /<slug>" (308) - with no server{} block and no map, and MUST
#     be included INSIDE the panel server{} block:
#
#         server {
#             server_name gate.example.com;
#             include /etc/nginx/tunnelgate/routes.conf;
#             location / { proxy_pass http://127.0.0.1:8080; ... }
#         }
#
#     The panel vhost must also declare map $http_upgrade $connection_upgrade
#     { default upgrade; '' close; } in its HTTP context - the merged file's router
#     locations reference $connection_upgrade, and a map is illegal inside a server
#     block. Omit it and "nginx -t" fails with unknown "connection_upgrade" variable;
#     declare it twice and the later map silently wins.
#
#     Get the include context wrong and nginx refuses the config outright rather than
#     serving something wrong: the merged file in the HTTP context fails with
#     "location" directive is not allowed here, and a separate-layout file inside a
#     server block fails with "server" directive is not allowed here - both pointing
#     at routes.conf:1, not at your vhost. Doctor's "routes include" check runs
#     nginx -t and names the context the current layout wants; the merged layout is
#     reported under "gateway host".
#
#     Router slugs also land in the panel's path namespace: "api" and "assets" clash
#     with the panel vhost's own locations and nginx rejects the whole config
#     ("duplicate location"), while "login", "hosts", "settings", "audit" and
#     "routers" are SPA routes that get shadowed - a router called "login" locks the
#     operator out of the panel entirely. Rename such routers before switching over;
#     nothing reserves these names for you. The separate layout has no such clash.
#
#     THE TRADE: in merged mode the panel and the routers share scheme+host+port, and
#     a path is not an origin boundary. A hostile or compromised router page runs
#     JavaScript in the panel's origin, can issue same-origin requests with the
#     operator's session cookie and read the CSRF token from /api/auth/me - i.e. it
#     can act as the signed-in operator. What still holds: tg_session is HttpOnly,
#     and the panel vhost drops the browser Cookie header before proxying
#     (proxy_set_header Cookie ""), so the router SERVER never receives the session
#     cookie; router access is still gated by auth_request and the single-use launch
#     ticket. What is lost is origin isolation. Keep the gateway on its own name
#     whenever DNS and certificates allow it; docs/SECURITY.md §6.1 has the detail.
#
# Only the wildcard is dropped when you switch, not the panel/console names: one
# ordinary certificate covering all three names is enough (HTTP-01, no DNS plugin).
# TUNNELGATE_ROUTE_MODE=path
# TUNNELGATE_GATEWAY_HOST=gate.example.com
TUNNELGATE_COOKIE_SECURE=true
# DO NOT SET THIS UNLESS YOU HAVE READ docs/SECURITY.md §6.
# Unset (the default) the session cookie is HOST-ONLY: panel.example.com sets it and
# the browser never sends it to <slug>.panel.example.com or console.panel.example.com.
# That is the posture the rest of this file assumes.
#
# Setting a domain cookie makes the browser attach tg_session to EVERY name under the
# domain - including every router's LuCI. The blast radius is therefore inverted: the
# operator's panel session travels to a device whose only job is to be a cheap,
# internet-exposed router, and anyone who compromises one router gets a live panel
# session (full panel access), not just that router. The panel does strip Cookies on
# the router hop in both drivers (render_nginx() emits proxy_set_header Cookie "";
# render_caddy_route() emits delete: ["Cookie"]; deploy/nginx/router-vhost.conf.template
# and deploy/caddy/Caddyfile show the hand-written equivalents). Three lines are still
# three lines: keeping the cookie host-only is the structural fix, and it is the only
# part that does not depend on a vhost being generated by the panel.
#
# Enable it only if the SPA and the API genuinely live on different hostnames and you
# accept that trade-off.
# TUNNELGATE_COOKIE_DOMAIN=.panel.example.com

# --- router launch hand-off ---------------------------------------------
# Opening a router does NOT need the domain cookie above. The panel mints a
# single-use ticket, the router vhost redeems it (GET /__tg/enter) and answers with
# a cookie scoped to that router's own hostname, which is the only credential the
# auth subrequest accepts for it. Leave all three defaults alone unless you are
# deliberately shortening the window.
# Name of the router-host cookie. Renaming it is safe - the generated vhost is
# rendered from this setting - but every operator has to open their router once more.
TUNNELGATE_ROUTER_COOKIE_NAME=tg_luci
# Seconds a launch ticket stays redeemable after the click. It is single-use, so a
# longer window buys an interrupted redirect, not convenience.
TUNNELGATE_LAUNCH_TICKET_TTL_SECONDS=120
# Minutes the router-host cookie lives. Lower it if an unattended browser on a shared
# machine reaching one router's LuCI is a concern; there is no per-cookie revocation.
TUNNELGATE_ROUTER_SESSION_TTL_MINUTES=60
TUNNELGATE_BIND_ADDRESS=127.0.0.1
TUNNELGATE_PORT=8080

# --- storage -------------------------------------------------------------
TUNNELGATE_DB_URL=sqlite:////var/lib/tunnelgate/tunnelgate.db
TUNNELGATE_DATA_DIR=/var/lib/tunnelgate

# --- ssh -----------------------------------------------------------------
# 127.0.0.1 because the panel and sshd share the host. If sshd ever moves, this
# is the only line that changes.
TUNNELGATE_SSH_HOST=127.0.0.1
TUNNELGATE_SSH_USER=tunnelgate
TUNNELGATE_AUTHORIZED_KEYS_PATH=/var/lib/tunnelgate/.ssh/authorized_keys
# Empty: sshd reload is out of band. authorized_keys is re-read on the next
# authentication, so a reload is not needed for new keys to work.
TUNNELGATE_SSHD_RELOAD_COMMAND=

# --- port pools ----------------------------------------------------------
# Tunnel ports are sshd loopback listeners: NEVER open them in the firewall.
TUNNELGATE_PORT_MIN=20000
TUNNELGATE_PORT_MAX=25000
# Console ports are also loopback-only sshd listeners. Same rule.
TUNNELGATE_CONSOLE_PORT_MIN=25001
TUNNELGATE_CONSOLE_PORT_MAX=30000
TUNNELGATE_CONSOLE_ENABLED=true
TUNNELGATE_CONSOLE_IDLE_TIMEOUT_SECONDS=900
TUNNELGATE_CONSOLE_MAX_SESSIONS_PER_USER=3
TUNNELGATE_CONSOLE_MAX_SESSION_SECONDS=7200
# Account the console logs in as on the ROUTER. The console key is installed for this
# user, and the panel dials it, so both sides always agree. Leave it at root unless you
# created a dedicated account on the device: docs/SECURITY.md §5 has the trade-off.
# TUNNELGATE_CONSOLE_SSH_USER=root

# --- reverse proxy -------------------------------------------------------
TUNNELGATE_PROXY_DRIVER=nginx
TUNNELGATE_PROXY_ROUTES_PATH=/etc/nginx/tunnelgate/routes.conf
# SYSTEMD INSTALLS: leave this EMPTY. The unit sets NoNewPrivileges=yes, so the
# panel cannot sudo, and a reload command would fail on every route change.
# Use the tunnelgate-nginx-reload.path unit instead (deploy/systemd/), which runs
# as root and validates with nginx -t before reloading.
# COMPOSE INSTALLS: also leave it empty; the nginx service watches the file.
# You would only set a command here if the panel held a sudoers rule AND the unit
# had NoNewPrivileges=no.
TUNNELGATE_PROXY_RELOAD_COMMAND=

# --- health / monitoring -------------------------------------------------
TUNNELGATE_TUNNEL_POLL_SECONDS=5
TUNNELGATE_HEALTH_TIMEOUT_SECONDS=3.0
TUNNELGATE_STALE_OFFLINE_SECONDS=90
TUNNELGATE_REQUIRE_HEALTH_FOR_ONLINE=true
# How long a bootstrap token stays valid; the installer agents are the only
# consumers.
TUNNELGATE_BOOTSTRAP_TTL_MINUTES=30

# --- secrets -------------------------------------------------------------
TUNNELGATE_SECRET_KEY=CHANGE-ME
TUNNELGATE_ADMIN_PASSWORD=CHANGE-ME
