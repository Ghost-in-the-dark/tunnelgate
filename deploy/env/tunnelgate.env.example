# =============================================================================
# TunnelGate environment file
#
#   sudo install -m 0600 /dev/null /etc/tunnelgate.env
#   sudo editor /etc/tunnelgate.env
#
# Read by systemd (EnvironmentFile=) and by docker compose (env_file:). Every key
# is TUNNELGATE_-prefixed because app/config.py uses that env_prefix. Full
# reference: docs/INSTALL_SERVER.md section 5.
#
# Generate the secrets, do not invent them:
#   openssl rand -base64 48   -> TUNNELGATE_SECRET_KEY
#   openssl rand -base64 24   -> TUNNELGATE_ADMIN_PASSWORD
# Losing TUNNELGATE_SECRET_KEY invalidates every stored console key.
# =============================================================================

TUNNELGATE_ENV=production
TUNNELGATE_LOG_LEVEL=info

# --- panel ---------------------------------------------------------------
# PANEL_URL is what browsers are sent to (login redirects use it); it must be the
# public https URL, not the loopback bind address.
TUNNELGATE_PANEL_URL=https://panel.example.com
TUNNELGATE_PANEL_HOST=panel.example.com
# Router vhosts are <slug>.<SUBDOMAIN_SUFFIX>; the console is console.<suffix>.
TUNNELGATE_SUBDOMAIN_SUFFIX=panel.example.com
TUNNELGATE_COOKIE_SECURE=true
TUNNELGATE_COOKIE_DOMAIN=.panel.example.com
TUNNELGATE_BIND_ADDRESS=127.0.0.1
TUNNELGATE_PORT=8080

# --- storage -------------------------------------------------------------
TUNNELGATE_DB_URL=sqlite:////var/lib/tunnelgate/tunnelgate.db
TUNNELGATE_DATA_DIR=/var/lib/tunnelgate

# --- ssh -----------------------------------------------------------------
# 127.0.0.1 because the panel and sshd share the host. If sshd ever moves, this
# is the only line that changes.
TUNNELGATE_SSH_HOST=127.0.0.1
TUNNELGATE_SSH_USER=tunnelgate
TUNNELGATE_AUTHORIZED_KEYS_PATH=/var/lib/tunnelgate/.ssh/authorized_keys
# Empty: sshd reload is out of band. authorized_keys is re-read on the next
# authentication, so a reload is not needed for new keys to work.
TUNNELGATE_SSHD_RELOAD_COMMAND=

# --- port pools ----------------------------------------------------------
# Tunnel ports are sshd loopback listeners: NEVER open them in the firewall.
TUNNELGATE_PORT_MIN=20000
TUNNELGATE_PORT_MAX=25000
# Console ports are also loopback-only sshd listeners. Same rule.
TUNNELGATE_CONSOLE_PORT_MIN=25001
TUNNELGATE_CONSOLE_PORT_MAX=30000
TUNNELGATE_CONSOLE_ENABLED=true
TUNNELGATE_CONSOLE_IDLE_TIMEOUT_SECONDS=900
TUNNELGATE_CONSOLE_MAX_SESSIONS_PER_USER=3
TUNNELGATE_CONSOLE_MAX_SESSION_SECONDS=7200

# --- reverse proxy -------------------------------------------------------
TUNNELGATE_PROXY_DRIVER=nginx
TUNNELGATE_PROXY_ROUTES_PATH=/etc/nginx/tunnelgate/routes.conf
# SYSTEMD INSTALLS: leave this EMPTY. The unit sets NoNewPrivileges=yes, so the
# panel cannot sudo, and a reload command would fail on every route change.
# Use the tunnelgate-nginx-reload.path unit instead (deploy/systemd/), which runs
# as root and validates with nginx -t before reloading.
# COMPOSE INSTALLS: also leave it empty; the nginx service watches the file.
# You would only set a command here if the panel held a sudoers rule AND the unit
# had NoNewPrivileges=no.
TUNNELGATE_PROXY_RELOAD_COMMAND=

# --- health / monitoring -------------------------------------------------
TUNNELGATE_TUNNEL_POLL_SECONDS=5
TUNNELGATE_HEALTH_TIMEOUT_SECONDS=3.0
TUNNELGATE_STALE_OFFLINE_SECONDS=90
TUNNELGATE_REQUIRE_HEALTH_FOR_ONLINE=true
# How long a bootstrap token stays valid; the installer agents are the only
# consumers.
TUNNELGATE_BOOTSTRAP_TTL_MINUTES=30

# --- secrets -------------------------------------------------------------
TUNNELGATE_SECRET_KEY=CHANGE-ME
TUNNELGATE_ADMIN_PASSWORD=CHANGE-ME
